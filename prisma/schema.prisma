/// FAHRSCHULE TAYM — PostgreSQL / Prisma 7
/// Full baseline: accounts, applications, files, training, schedules, payments,
/// candidate communications and administrative actions.
/// Existing authentication tables/column names are preserved for current SQL APIs.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 1 — Registration and OTP (compatible with existing APIs)
model PendingRegistration {
  id                String                     @id @default(uuid()) @db.Uuid
  status            String                     @default("PENDING_VERIFICATION") @db.VarChar(32)
  firstName         String                     @map("first_name") @db.VarChar(80)
  lastName          String                     @map("last_name") @db.VarChar(80)
  fullName          String                     @map("full_name") @db.VarChar(170)
  countryCode       String                     @map("country_code") @db.VarChar(2)
  phoneCountryCode  String                     @map("phone_country_code") @db.VarChar(2)
  dialCode          String                     @map("dial_code") @db.VarChar(5)
  phoneE164         String                     @unique(map: "pending_registrations_phone_e164_key") @map("phone_e164") @db.VarChar(16)
  email             String                     @unique(map: "pending_registrations_email_key") @db.VarChar(254)
  passwordHash      String                     @map("password_hash") @db.VarChar(512)
  acceptedTermsAt   DateTime                   @map("accepted_terms_at") @db.Timestamptz(3)
  acceptedPrivacyAt DateTime                   @map("accepted_privacy_at") @db.Timestamptz(3)
  resendTokenHash   String                     @unique(map: "pending_registrations_resend_token_hash_key") @map("resend_token_hash") @db.VarChar(64)
  emailVerifiedAt   DateTime?                  @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt   DateTime?                  @map("phone_verified_at") @db.Timestamptz(3)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime                   @map("expires_at") @db.Timestamptz(3)
  verifications     RegistrationVerification[]

  @@index([status, expiresAt], map: "pending_registrations_status_expires_idx")
  @@index([createdAt], map: "pending_registrations_created_at_idx")
  @@map("pending_registrations")
}

model RegistrationVerification {
  id             String              @id @default(uuid()) @db.Uuid
  registrationId String              @map("registration_id") @db.Uuid
  registration   PendingRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "registration_verifications_registration_id_fkey")
  channel        String              @db.VarChar(10) // EMAIL | SMS
  destination    String              @db.VarChar(254)
  codeHash       String              @map("code_hash") @db.VarChar(64)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime            @map("expires_at") @db.Timestamptz(3)
  attempts       Int                 @default(0)
  verifiedAt     DateTime?           @map("verified_at") @db.Timestamptz(3)
  resendCount    Int                 @default(0) @map("resend_count")
  lastSentAt     DateTime?           @map("last_sent_at") @db.Timestamptz(3)
  deliveryStatus String              @default("SENDING") @map("delivery_status") @db.VarChar(16)

  @@unique([registrationId, channel], map: "registration_verifications_registration_channel_key")
  @@index([channel, deliveryStatus], map: "registration_verifications_channel_delivery_idx")
  @@index([expiresAt], map: "registration_verifications_expires_at_idx")
  @@map("registration_verifications")
}

// 2 — Accounts, access and candidate profile
model User {
  id                    String                     @id @default(uuid()) @db.Uuid
  firstName             String                     @map("first_name") @db.VarChar(80)
  lastName              String                     @map("last_name") @db.VarChar(80)
  fullName              String                     @map("full_name") @db.VarChar(170)
  email                 String                     @unique(map: "users_email_key") @db.VarChar(254)
  phoneE164             String                     @unique(map: "users_phone_e164_key") @map("phone_e164") @db.VarChar(16)
  countryCode           String                     @map("country_code") @db.VarChar(2)
  phoneCountryCode      String                     @map("phone_country_code") @db.VarChar(2)
  dialCode              String                     @map("dial_code") @db.VarChar(5)
  passwordHash          String                     @map("password_hash") @db.VarChar(512)
  emailVerifiedAt       DateTime?                  @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt       DateTime?                  @map("phone_verified_at") @db.Timestamptz(3)
  acceptedTermsAt       DateTime                   @map("accepted_terms_at") @db.Timestamptz(3)
  acceptedPrivacyAt     DateTime                   @map("accepted_privacy_at") @db.Timestamptz(3)
  status                String                     @default("ACTIVE") @db.VarChar(20)
  role                  String                     @default("CANDIDATE") @db.VarChar(20) // never trust role supplied by registration client
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  passwordResetRequests PasswordResetRequest[]
  profile               CandidateProfile?
  sessions              UserSession[]
  applications          LicenseApplication[]       @relation("Applicant")
  assignedApplications  LicenseApplication[]       @relation("ApplicationAgent")
  applicationHistory    ApplicationStatusHistory[]
  uploadedDocuments     CandidateDocument[]        @relation("DocumentUploader")
  reviewedDocuments     CandidateDocument[]        @relation("DocumentReviewer")
  enrollments           CourseEnrollment[]
  theoryProgress        TheoryProgress[]
  theoryAttempts        TheoryExamAttempt[]
  drivingLessons        DrivingLesson[]            @relation("DrivingStudent")
  instructedLessons     DrivingLesson[]            @relation("DrivingInstructor")
  appointments          Appointment[]              @relation("AppointmentCandidate")
  managedAppointments   Appointment[]              @relation("AppointmentStaff")
  payments              Payment[]
  notifications         Notification[]
  sentMessages          Message[]                  @relation("MessageSender")
  receivedMessages      Message[]                  @relation("MessageRecipient")
  auditActions          AdminAuditLog[]

  @@index([status], map: "users_status_idx")
  @@index([countryCode], map: "users_country_code_idx")
  @@index([createdAt], map: "users_created_at_idx")
  @@index([role, status])
  @@map("users")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "user_sessions_user_id_fkey")
  tokenHash String    @unique(map: "user_sessions_token_hash_key") @map("token_hash") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([userId, revokedAt], map: "user_sessions_user_revoked_idx")
  @@index([expiresAt], map: "user_sessions_expires_at_idx")
  @@map("user_sessions")
}

model CandidateProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  placeOfBirth    String?   @map("place_of_birth") @db.VarChar(150)
  nationality     String?   @db.VarChar(100)
  streetAddress   String?   @map("street_address") @db.VarChar(200)
  addressLine2    String?   @map("address_line_2") @db.VarChar(150)
  postalCode      String?   @map("postal_code") @db.VarChar(24)
  city            String?   @db.VarChar(120)
  region          String?   @db.VarChar(120)
  countryCode     String?   @map("country_code") @db.VarChar(2)
  preferredLocale String    @default("de") @map("preferred_locale") @db.VarChar(2)
  photoStorageKey String?   @map("photo_storage_key") @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("candidate_profiles")
}

// 3 — Permit applications and administrative workflow
model LicenseApplication {
  id                     String    @id @default(uuid()) @db.Uuid
  applicationNumber      String    @unique @map("application_number") @db.VarChar(80)
  applicantId            String    @map("applicant_id") @db.Uuid
  applicant              User      @relation("Applicant", fields: [applicantId], references: [id], onDelete: Restrict)
  assignedAgentId        String?   @map("assigned_agent_id") @db.Uuid
  assignedAgent          User?     @relation("ApplicationAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  countryCode            String    @map("country_code") @db.VarChar(2)
  licenseClass           String    @map("license_class") @db.VarChar(20) // B, BE, B96, AM, A1, A2, A, C, CE, D, DE, T, L
  applicationType        String    @default("FIRST_LICENSE") @map("application_type") @db.VarChar(32) // FIRST_LICENSE, EXTENSION, EXCHANGE, RENEWAL
  status                 String    @default("DRAFT") @db.VarChar(32) // DRAFT, SUBMITTED, REVIEWING, NEEDS_INFO, APPROVED, REJECTED, COMPLETED, CANCELLED
  currentStep            String?   @map("current_step") @db.VarChar(40)
  firstName              String    @map("first_name") @db.VarChar(80)
  lastName               String    @map("last_name") @db.VarChar(80)
  email                  String    @db.VarChar(254)
  phoneE164              String    @map("phone_e164") @db.VarChar(16)
  dateOfBirth            DateTime? @map("date_of_birth") @db.Date
  placeOfBirth           String?   @map("place_of_birth") @db.VarChar(150)
  nationality            String?   @db.VarChar(100)
  streetAddress          String?   @map("street_address") @db.VarChar(200)
  addressLine2           String?   @map("address_line_2") @db.VarChar(150)
  postalCode             String?   @map("postal_code") @db.VarChar(24)
  city                   String?   @db.VarChar(120)
  region                 String?   @db.VarChar(120)
  existingLicenseCountry String?   @map("existing_license_country") @db.VarChar(2)
  existingLicenseNumber  String?   @map("existing_license_number") @db.VarChar(100)
  existingLicenseClass   String?   @map("existing_license_class") @db.VarChar(60)
  administrativeNotes    String?   @map("administrative_notes") @db.Text // staff only, never return to candidate
  applicantNotes         String?   @map("applicant_notes") @db.Text
  submittedAt            DateTime? @map("submitted_at") @db.Timestamptz(3)
  reviewedAt             DateTime? @map("reviewed_at") @db.Timestamptz(3)
  completedAt            DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Fields used by the candidate application workflow.
  userId                     String?   @map("user_id") @db.Uuid
  reference                  String?   @unique @db.VarChar(80)
  category                   String?   @db.VarChar(20)
  residentialAddress         String?   @map("residential_address") @db.VarChar(200)
  confirmedInformation       Boolean   @default(false) @map("confirmed_information")
  acceptedDocumentProcessing Boolean   @default(false) @map("accepted_document_processing")
  currency                   String?   @db.VarChar(3)
  trainingPriceCents         Int?      @map("training_price_cents")
  registrationFeeCents       Int?      @map("registration_fee_cents")
  totalPriceCents            Int?      @map("total_price_cents")
  pricingVersion             String?   @map("pricing_version") @db.VarChar(80)
  admissionReviewRequired    Boolean   @default(false) @map("admission_review_required")
  admissionReviewIssues      Json      @default("[]") @map("admission_review_issues")
  documentCount              Int       @default(0) @map("document_count")
  locale                     String    @default("de") @db.VarChar(2)
  revision                   Int       @default(0)
  informationConfirmedAt     DateTime? @map("information_confirmed_at") @db.Timestamptz(3)
  documentProcessingAcceptedAt DateTime? @map("document_processing_accepted_at") @db.Timestamptz(3)
  confirmationVersion        String?   @map("confirmation_version") @db.VarChar(80)
  candidateSnapshot          Json?     @map("candidate_snapshot")

  documents     CandidateDocument[]
  statusHistory ApplicationStatusHistory[]
  enrollments   CourseEnrollment[]
  lessons       DrivingLesson[]
  appointments  Appointment[]
  payments      Payment[]
  messages      Message[]

  @@index([applicantId, createdAt])
  @@index([status, countryCode])
  @@index([assignedAgentId, status])
  @@map("license_applications")
}

model ApplicationStatusHistory {
  id             String             @id @default(uuid()) @db.Uuid
  applicationId  String             @map("application_id") @db.Uuid
  application    LicenseApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedById    String?            @map("changed_by_id") @db.Uuid
  changedBy      User?              @relation(fields: [changedById], references: [id], onDelete: SetNull)
  previousStatus String?            @map("previous_status") @db.VarChar(32)
  newStatus      String             @map("new_status") @db.VarChar(32)
  publicNote     String?            @map("public_note") @db.Text
  internalNote   String?            @map("internal_note") @db.Text
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([applicationId, createdAt])
  @@map("application_status_history")
}

// 4 — Secure uploaded documents (only metadata; files in private object storage)
model CandidateDocument {
  id              String              @id @default(uuid()) @db.Uuid
  applicationId   String?             @map("application_id") @db.Uuid
  application     LicenseApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedById    String              @map("uploaded_by_id") @db.Uuid
  uploadedBy      User                @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedById    String?             @map("reviewed_by_id") @db.Uuid
  reviewedBy      User?               @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  documentType    String              @map("document_type") @db.VarChar(50) // ID, RESIDENCE, PHOTO, MEDICAL, LICENSE, OTHER
  title           String              @db.VarChar(180)
  originalName    String              @map("original_name") @db.VarChar(255)
  storageKey      String              @unique @map("storage_key") @db.VarChar(500)
  mimeType        String              @map("mime_type") @db.VarChar(100)
  sizeBytes       BigInt              @map("size_bytes")
  sha256          String?             @db.VarChar(64)
  status          String              @default("PENDING") @db.VarChar(24) // PENDING, APPROVED, REJECTED, REPLACED
  rejectionReason String?             @map("rejection_reason") @db.Text
  reviewedAt      DateTime?           @map("reviewed_at") @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Private upload metadata.
  userId         String?   @map("user_id") @db.Uuid
  type           String?   @db.VarChar(50)
  fileName       String?   @map("file_name") @db.VarChar(255)
  sha256Hash     String?   @map("sha256_hash") @db.VarChar(64)
  uploadStatus   String    @default("UPLOADED") @map("upload_status") @db.VarChar(20)
  securityStatus String    @default("PENDING") @map("security_status") @db.VarChar(20)
  reviewStatus   String    @default("PENDING") @map("review_status") @db.VarChar(20)
  scannedAt      DateTime? @map("scanned_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([uploadedById, createdAt])
  @@index([applicationId, documentType])
  @@index([status])
  @@map("candidate_documents")
}

// 5 — Theory training, real learning progress and tests
model TrainingCourse {
  id           String   @id @default(uuid()) @db.Uuid
  title        String   @db.VarChar(180)
  description  String?  @db.Text
  countryCode  String   @map("country_code") @db.VarChar(2)
  licenseClass String   @map("license_class") @db.VarChar(20)
  languageCode String   @default("de") @map("language_code") @db.VarChar(2)
  isPublished  Boolean  @default(false) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lessons     TheoryLesson[]
  enrollments CourseEnrollment[]
  attempts    TheoryExamAttempt[]

  @@index([countryCode, licenseClass, isPublished])
  @@map("training_courses")
}

model TheoryLesson {
  id          String         @id @default(uuid()) @db.Uuid
  courseId    String         @map("course_id") @db.Uuid
  course      TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String         @db.VarChar(200)
  content     Json?          @db.JsonB // structured educational content; validate at API boundary
  mediaKey    String?        @map("media_key") @db.VarChar(500)
  sequence    Int            @default(0)
  isPublished Boolean        @default(false) @map("is_published")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  progress TheoryProgress[]

  @@unique([courseId, sequence])
  @@map("theory_lessons")
}

model CourseEnrollment {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String              @map("course_id") @db.Uuid
  course        TrainingCourse      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  applicationId String?             @map("application_id") @db.Uuid
  application   LicenseApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  status        String              @default("ACTIVE") @db.VarChar(20)
  startedAt     DateTime            @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt   DateTime?           @map("completed_at") @db.Timestamptz(3)

  @@unique([userId, courseId])
  @@index([applicationId])
  @@map("course_enrollments")
}

model TheoryProgress {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String       @map("lesson_id") @db.Uuid
  lesson      TheoryLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status      String       @default("NOT_STARTED") @db.VarChar(20)
  score       Decimal?     @db.Decimal(5, 2)
  startedAt   DateTime?    @map("started_at") @db.Timestamptz(3)
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, lessonId])
  @@map("theory_progress")
}

model TheoryExamAttempt {
  id       String         @id @default(uuid()) @db.Uuid
  userId   String         @map("user_id") @db.Uuid
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String         @map("course_id") @db.Uuid
  course   TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  score    Decimal        @db.Decimal(5, 2)
  passed   Boolean
  total    Int            @default(0)
  correct  Int            @default(0)
  takenAt  DateTime       @default(now()) @map("taken_at") @db.Timestamptz(3)

  @@index([userId, takenAt])
  @@map("theory_exam_attempts")
}

// 6 — Practical training and calendar
model DrivingLesson {
  id              String              @id @default(uuid()) @db.Uuid
  studentId       String              @map("student_id") @db.Uuid
  student         User                @relation("DrivingStudent", fields: [studentId], references: [id], onDelete: Restrict)
  instructorId    String?             @map("instructor_id") @db.Uuid
  instructor      User?               @relation("DrivingInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  applicationId   String?             @map("application_id") @db.Uuid
  application     LicenseApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  countryCode     String              @map("country_code") @db.VarChar(2)
  licenseClass    String              @map("license_class") @db.VarChar(20)
  startsAt        DateTime            @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime            @map("ends_at") @db.Timestamptz(3)
  status          String              @default("SCHEDULED") @db.VarChar(20) // SCHEDULED, CONFIRMED, COMPLETED, CANCELLED, NO_SHOW
  location        String?             @db.VarChar(250)
  instructorNotes String?             @map("instructor_notes") @db.Text
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([studentId, startsAt])
  @@index([instructorId, startsAt])
  @@index([status, startsAt])
  @@map("driving_lessons")
}

model Appointment {
  id            String              @id @default(uuid()) @db.Uuid
  candidateId   String              @map("candidate_id") @db.Uuid
  candidate     User                @relation("AppointmentCandidate", fields: [candidateId], references: [id], onDelete: Restrict)
  staffId       String?             @map("staff_id") @db.Uuid
  staff         User?               @relation("AppointmentStaff", fields: [staffId], references: [id], onDelete: SetNull)
  applicationId String?             @map("application_id") @db.Uuid
  application   LicenseApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  type          String              @db.VarChar(40) // CONSULTATION, THEORY_EXAM, PRACTICAL_EXAM, DOCUMENT_REVIEW, OTHER
  title         String              @db.VarChar(180)
  countryCode   String              @map("country_code") @db.VarChar(2)
  location      String?             @db.VarChar(250)
  startsAt      DateTime            @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime?           @map("ends_at") @db.Timestamptz(3)
  status        String              @default("SCHEDULED") @db.VarChar(20)
  publicNotes   String?             @map("public_notes") @db.Text
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([candidateId, startsAt])
  @@index([staffId, startsAt])
  @@index([applicationId])
  @@map("appointments")
}

// 7 — Payments and financial records
model Payment {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  applicationId String?             @map("application_id") @db.Uuid
  application   LicenseApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  reference     String              @unique @db.VarChar(80)
  amount        Decimal             @db.Decimal(12, 2)
  currency      String              @default("EUR") @db.VarChar(3)
  purpose       String              @db.VarChar(60)
  provider      String?             @db.VarChar(50)
  providerRef   String?             @unique @map("provider_ref") @db.VarChar(180)
  status        String              @default("PENDING") @db.VarChar(20) // PENDING, PAID, FAILED, REFUNDED, CANCELLED
  paidAt        DateTime?           @map("paid_at") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

// 8 — Candidate notifications, conversations and administration log
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(180)
  body      String    @db.Text
  linkPath  String?   @map("link_path") @db.VarChar(300)
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Message {
  id            String              @id @default(uuid()) @db.Uuid
  senderId      String              @map("sender_id") @db.Uuid
  sender        User                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipientId   String              @map("recipient_id") @db.Uuid
  recipient     User                @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  applicationId String?             @map("application_id") @db.Uuid
  application   LicenseApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  subject       String?             @db.VarChar(180)
  body          String              @db.Text
  readAt        DateTime?           @map("read_at") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([recipientId, readAt, createdAt])
  @@index([senderId, createdAt])
  @@index([applicationId])
  @@map("messages")
}

model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(80)
  targetType String   @map("target_type") @db.VarChar(80)
  targetId   String?  @map("target_id") @db.VarChar(80)
  metadata   Json?    @db.JsonB // do not include passwords, OTPs, tokens or sensitive documents
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

/// ==========================================================
/// PASSWORD RESET REQUESTS
/// Secure email-based password recovery.
/// ==========================================================

model PasswordResetRequest {
  id String @id @default(uuid()) @db.Uuid

  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  email String @unique @db.VarChar(254)

  codeHash String @map("code_hash") @db.VarChar(64)

  codeExpiresAt DateTime @map("code_expires_at") @db.Timestamptz(3)

  attempts Int @default(0)

  requestCount Int @default(1) @map("request_count")

  requestWindowStartedAt DateTime @default(now()) @map("request_window_started_at") @db.Timestamptz(3)

  lastSentAt DateTime @default(now()) @map("last_sent_at") @db.Timestamptz(3)

  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)

  resetTokenHash String? @unique @map("reset_token_hash") @db.VarChar(64)

  resetTokenExpiresAt DateTime? @map("reset_token_expires_at") @db.Timestamptz(3)

  passwordFingerprint String? @map("password_fingerprint") @db.VarChar(64)

  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([codeExpiresAt])
  @@index([updatedAt])
  @@map("password_reset_requests")
}

// Durable queues for private object cleanup and submission emails.
model ApplicationStorageCleanupJob {
  id String @id @db.Uuid
  bucket String @db.VarChar(100)
  storageKey String @map("storage_key") @db.VarChar(500)
  attempts Int @default(0)
  lastErrorCode String? @map("last_error_code") @db.VarChar(100)
  nextAttemptAt DateTime @map("next_attempt_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  @@unique([bucket, storageKey])
  @@map("application_storage_cleanup_jobs")
}

model ApplicationEmailJob {
  id String @id @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  kind String @db.VarChar(20)
  status String @db.VarChar(20)
  payload Json
  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(200)
  attempts Int @default(0)
  firstAttemptAt DateTime? @map("first_attempt_at") @db.Timestamptz(3)
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  leaseToken String? @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  providerEmailId String? @map("provider_email_id") @db.VarChar(200)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  lastErrorCode String? @map("last_error_code") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  @@unique([applicationId, kind])
  @@map("application_email_jobs")
}
